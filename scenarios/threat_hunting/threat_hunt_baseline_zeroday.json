{
  "metadata": {
    "name": "threat_hunt_baseline_zeroday",
    "description": "Combined zero-day-like stealth sweep with no signature-specific recipe dependency.",
    "version": "1.0"
  },
  "evaluation": {
    "runner": "hunting_closed_loop_evaluation",
    "output_dir": "output/threat_hunting/threat_hunt_baseline_zeroday",
    "seeds": [0, 1, 2]
  },
  "missions": ["critical_hunter"],
  "products": ["profiles/products/sample_threat_hunting_platform.json"],
  "topology": {"preset": "enterprise"},
  "hunting": {
    "recipes": ["recipes/threat_hunting/critical_path_approach_v1.json"],
    "evaluation_runs": 3,
    "noise_profiles": ["none"],
    "simulation_steps": 20,
    "simulation_overrides": {
      "stochastic_detection": true,
      "stochastic_success": true,
      "perceived_utility_enabled": true,
      "frustration_enabled": true,
      "retreat_based_on": "frustration",
      "frustration_retreat_threshold": 8.0,
      "attacker_patience": 30
    },
    "stealth_sweep": [
      {"name": "zero", "attacker_stealth_enabled": false},
      {"name": "linear", "attacker_stealth_enabled": true, "c2_jitter_ratio": 0.2, "dns_tunnel_chunk_size": 768},
      {"name": "saturation", "attacker_stealth_enabled": true, "c2_jitter_ratio": 0.6, "dns_tunnel_chunk_size": 256, "process_masquerading": true},
      {"name": "strong", "attacker_stealth_enabled": true, "c2_jitter_ratio": 1.0, "dns_tunnel_chunk_size": 32, "process_masquerading": true, "domain_homoglyph_enabled": true, "hunting_awareness_threshold": 0.5, "sleep_or_slowdown_factor": 3.0}
    ]
  }
}
