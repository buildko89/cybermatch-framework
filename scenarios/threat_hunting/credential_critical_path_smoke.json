{
  "metadata": {
    "name": "credential_critical_path_smoke",
    "description": "Small reproducible scenario for comparing hunting capabilities without enabling closed-loop feedback.",
    "version": "1.0"
  },
  "evaluation": {
    "runner": "hunting_recipe_evaluation",
    "output_dir": "output/threat_hunting/credential_critical_path_smoke",
    "seeds": [0]
  },
  "missions": ["critical_hunter"],
  "products": [
    "profiles/products/sample_threat_hunting_platform.json",
    "profiles/products/sample_behavioral_profiling.json",
    "profiles/products/sample_ml_assisted_hunting.json"
  ],
  "topology": {
    "preset": "enterprise"
  },
  "hunting": {
    "recipes": [
      "recipes/threat_hunting/credential_to_critical_path_v1.json",
      "recipes/threat_hunting/critical_path_approach_v1.json"
    ],
    "baseline_runs": 0,
    "evaluation_runs": 1,
    "noise_profiles": ["none", "moderate", "adversarial"],
    "simulation_steps": 12,
    "simulation_overrides": {
      "stochastic_detection": true,
      "stochastic_success": true
    }
  }
}
