{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "route_task",
    "requested_model",
    "resolved_model",
    "request_id",
    "fallback_level",
    "fallback_model",
    "prompt_sha256",
    "result_view_hash",
    "bundle_hash",
    "output_hash",
    "prompt_tokens",
    "completion_tokens",
    "total_tokens",
    "cost_usd",
    "latency_ms",
    "validation_status",
    "failure_class",
    "failure_detail",
    "policy_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "route_task": {"const": "cybermatch_result_explanation_v1"},
    "requested_model": {"type": "string", "minLength": 1, "maxLength": 128},
    "resolved_model": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "request_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "fallback_level": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
    "fallback_model": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "prompt_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "result_view_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
    "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "latency_ms": {"type": ["number", "null"], "minimum": 0},
    "validation_status": {"enum": ["accepted", "rejected", "fallback"]},
    "failure_class": {
      "type": ["string", "null"],
      "enum": [
        null,
        "timeout",
        "authentication",
        "authorization",
        "rate_limited",
        "upstream_unavailable",
        "transport",
        "invalid_response",
        "schema_validation",
        "grounding_validation",
        "policy_denied",
        "configuration",
        "unknown"
      ]
    },
    "failure_detail": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "policy_version": {"const": "1.0"}
  }
}
