{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "orcarouter"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "backend": {"const": "orcarouter"},
    "orcarouter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "api_key_env",
        "partner_tag",
        "task",
        "model",
        "allowed_models",
        "allowed_resolved_models",
        "fallback_models",
        "free_only",
        "temperature",
        "timeout_seconds",
        "max_retries",
        "max_response_bytes",
        "include_cost",
        "usage_log_path"
      ],
      "properties": {
        "base_url": {"const": "https://api.orcarouter.ai/v1"},
        "api_key_env": {"const": "ORCAROUTER_API_KEY"},
        "partner_tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "task": {"const": "cybermatch_result_explanation_v1"},
        "model": {"$ref": "#/$defs/model"},
        "allowed_models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/model"}
        },
        "allowed_resolved_models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/model"}
        },
        "fallback_models": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/model"}
        },
        "free_only": {"type": "boolean"},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 120},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "include_cost": {"type": "boolean"},
        "usage_log_path": {"type": "string", "minLength": 1, "maxLength": 260},
        "task_routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cybermatch_result_explanation_v1": {
              "type": "object",
              "additionalProperties": false,
              "required": ["primary_model", "fallback_models"],
              "properties": {
                "primary_model": {"$ref": "#/$defs/model"},
                "fallback_models": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/model"}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{1,127}$"
    }
  }
}
