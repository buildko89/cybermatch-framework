{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermatch.local/schemas/benchmark-1.0.json",
  "title": "CyberMatch Benchmark",
  "type": "object",
  "required": ["metadata", "scenarios", "seeds"],
  "additionalProperties": false,
  "properties": {
    "metadata": {"type": "object", "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "type": {"type": "string"}, "profile": {"type": "string"}}, "additionalProperties": false},
    "scenarios": {"$ref": "#/$defs/paths"},
    "topologies": {"$ref": "#/$defs/paths"},
    "missions": {"$ref": "#/$defs/names"},
    "products": {"$ref": "#/$defs/paths"},
    "recipes": {"$ref": "#/$defs/paths"},
    "noise_profiles": {"$ref": "#/$defs/names"},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "defense_modes": {"$ref": "#/$defs/names"},
    "protocol_catalog": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_probability", "attack_capability", "static_control_scale"],
      "properties": {
        "observation_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "attack_capability": {"type": "number", "minimum": 0, "maximum": 1},
        "static_control_scale": {"type": "number", "minimum": 0, "maximum": 1},
        "containment_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "sensitivity_axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  },
  "$defs": {
    "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
