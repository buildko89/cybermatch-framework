{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermatch.local/schemas/scenario-1.0.json",
  "title": "CyberMatch Scenario",
  "type": "object",
  "required": ["metadata", "evaluation"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "industry": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["runner", "output_dir"],
      "properties": {
        "runner": {"type": "string", "minLength": 1},
        "output_dir": {"type": "string", "minLength": 1},
        "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}}
      },
      "additionalProperties": false
    },
    "missions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "products": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "topology": {"type": "object"},
    "characteristics": {"type": "object"},
    "hunting": {"type": "object"},
    "agentic": {"type": "object"},
    "threat_intelligence": {"type": "object"},
    "demo": {"type": "object"}
  },
  "anyOf": [
    {"required": ["agentic"]},
    {"required": ["threat_intelligence"]},
    {"required": ["missions", "products", "topology"]}
  ]
}
