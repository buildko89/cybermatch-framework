{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberMatch T4a token化replay source manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "evidence_class", "tenant_id", "input_file", "input_format", "normalization_version", "identity_key_version", "retention_days", "source_refs", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "evidence_class": {"const": "replay-backed"},
    "tenant_id": {"type": "string", "minLength": 1},
    "input_file": {"type": "string", "pattern": "^configs/active_defense/replay/[A-Za-z0-9_./-]+\\.(jsonl|csv)$"},
    "input_format": {"enum": ["jsonl", "csv"]},
    "normalization_version": {"type": "string", "minLength": 1},
    "identity_key_version": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "retention_days": {"type": "integer", "minimum": 1},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
