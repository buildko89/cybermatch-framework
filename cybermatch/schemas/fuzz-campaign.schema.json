{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermatch.local/schemas/fuzz-campaign-1.0.json",
  "title": "CyberMatch Fuzz Campaign",
  "type": "object",
  "required": ["schema_version", "id", "mode", "base_inputs", "target", "generation", "mutators", "oracles", "output_dir"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "base_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "target": {"type": "object", "required": ["adapter", "recipes"]},
    "generation": {"type": "object", "required": ["campaign_seed", "max_cases", "max_events_per_case", "max_mutations_per_case", "max_runtime_seconds"]},
    "mutators": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "oracles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_dir": {"type": "string", "minLength": 1}
  }
}
