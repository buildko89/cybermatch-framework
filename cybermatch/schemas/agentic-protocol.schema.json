{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermatch.local/schemas/agentic-protocol-2.0.json",
  "title": "Agentic Resilience Scenario Protocol Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "evidence_class", "scenarios"],
  "properties": {
    "protocol_version": {"const": "2.0"},
    "evidence_class": {"enum": ["synthetic", "replay-backed", "external-SUT-backed"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_name", "hypothesis", "observables", "ground_truth", "success_conditions", "failure_conditions", "non_goals"],
        "properties": {
          "scenario_name": {"type": "string", "minLength": 1},
          "hypothesis": {"type": "string", "minLength": 1},
          "observables": {"$ref": "#/$defs/texts"},
          "ground_truth": {"$ref": "#/$defs/texts"},
          "success_conditions": {"$ref": "#/$defs/texts"},
          "failure_conditions": {"$ref": "#/$defs/texts"},
          "non_goals": {"$ref": "#/$defs/texts"}
        }
      }
    }
  },
  "$defs": {
    "texts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
