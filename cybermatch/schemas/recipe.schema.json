{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermatch.local/schemas/recipe-1.0.json",
  "title": "CyberMatch Threat Hunting Recipe",
  "type": "object",
  "required": ["schema_version", "id", "version", "title", "hypothesis", "source", "required_fields", "group_by", "operations", "finding", "metadata"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "source": {"const": "observed"},
    "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "group_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["operator"]}},
    "finding": {"type": "object", "required": ["severity", "title", "reason", "score"], "properties": {"severity": {"enum": ["info", "low", "medium", "high", "critical"]}, "title": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "score": {"type": "number", "minimum": 0, "maximum": 1}, "condition": {"type": "object"}}, "additionalProperties": false},
    "metadata": {"type": "object"}
  }
}
